# ResearchGraph AI backend configuration. Copy to backend/.env and fill in what you need.
# Every value is optional: with nothing set the app runs fully offline (labelled demo reports
# built from real search results, local SQLite).

# --- Database ---------------------------------------------------------------------------
# Local SQLite by default. For Neon/PostgreSQL paste the connection string as given;
# postgresql:// is converted to asyncpg and sslmode/channel_binding are handled.
DATABASE_URL=sqlite+aiosqlite:///./research_system.db

# --- LLM (OpenRouter) ---------------------------------------------------------------------
# Free key: https://openrouter.ai/keys . Empty = offline demo mode.
OPENROUTER_API_KEY=

# Per-agent mode: each kind of agent has its own primary model.
# Supervisor (planner) / Specialists (data analyst) / Reviewers (verifier, critic) / Writers (writer, chat)
PLANNER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
SPECIALIST_MODEL=nvidia/nemotron-3.5-lightning:free
REVIEWER_MODEL=google/gemma-4-31b-it:free
WRITER_MODEL=nvidia/nemotron-3.5-super-vl:free

# Fallback tiers 2-4, shared by every agent in both modes, tried in this order.
SECONDARY_MODEL=google/gemma-4-31b-it:free
THIRD_MODEL=nvidia/nemotron-3.5-super-vl:free
FALLBACK_MODEL=openrouter/free

# "One model for all agents" mode: the models offered in the UI (comma-separated) and the preselected one.
MODEL_OPTIONS=nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free,nvidia/nemotron-3.5-super-vl:free,nvidia/nemotron-3.5-lightning:free,google/gemma-4-26b-a4b-it:free,openrouter/free
DEFAULT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

LLM_TIMEOUT_S=90
# How many times the critic may send a draft back to the writer (each costs 2 model calls).
MAX_REVISIONS=1

# --- Search -------------------------------------------------------------------------------
# auto = Tavily when TAVILY_API_KEY is set, otherwise DuckDuckGo (ddgs). off = no web search.
SEARCH_PROVIDER=auto
# Optional, more reliable than DuckDuckGo; free tier at https://tavily.com
TAVILY_API_KEY=

# --- Web & abuse protection ---------------------------------------------------------------
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://mutli-agent-orchestration.vercel.app
# Per client IP.
RESEARCH_RATE_LIMIT_PER_HOUR=6
CHAT_RATE_LIMIT_PER_MIN=10
# Runs in progress at once, across all users.
MAX_CONCURRENT_RUNS=3
MAX_QUERY_CHARS=2000
MAX_CHAT_CHARS=2000
